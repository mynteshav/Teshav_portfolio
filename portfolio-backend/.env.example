# ====================================================================
# Teshav Sharma Portfolio Backend - Environment Variables
# ====================================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=True

# CORS - Comma-separated list of allowed frontend origins (NO trailing slashes)
# In production, replace with your custom domain (e.g., https://teshavsharma.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Gmail SMTP Configuration
# NOTE: Never use your regular Gmail password! Generate a 16-character Google App Password.
# Instructions:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named 'Portfolio Backend'
# 4. Copy the generated 16-character code (without spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your.email@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password
CONTACT_RECEIVER_EMAIL=teshavsharma74@gmail.com

# Rate Limiting & Anti-Spam
RATE_LIMIT_PER_MINUTE=5

# Local SQLite Storage for Contact Submissions
SQLITE_DB_PATH=contact_submissions.db
